POSTGRES_DB=financeapp
POSTGRES_USER=financeapp
POSTGRES_PASSWORD=changeme

# Double underscore is required, not single — ASP.NET Core's env-var config provider maps "__" to ":"
# to nest under the "AI" section; a single "_" stays a flat key and is silently never read (found while
# implementing ChatClientFactory, docs/spec.md §3.1/§3.2 — this file had the single-underscore bug before).
AI__ENGINE_TYPE=Ollama         # Azure | OpenAI | Ollama | Gemini | Anthropic
AI__ENDPOINT=http://host.docker.internal:11434
AI__MODEL_NAME=llama3.2
AI__API_KEY=
AI__SUPPORTS_VISION=false
