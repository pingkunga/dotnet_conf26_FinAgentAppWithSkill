<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\FinanceApp.Core\FinanceApp.Core.csproj" />
    <ProjectReference Include="..\FinanceApp.AI\FinanceApp.AI.csproj" />
    <ProjectReference Include="..\FinanceApp.Skills\FinanceApp.Skills.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="Markdig" />
    <!-- MCP-based skill client wiring ChatSessionService's .UseMcpSkills(...) call
         and McpServerLauncher's McpClient/HttpClientTransport usage both need this. -->
    <PackageReference Include="Microsoft.Agents.AI.Mcp" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

  <!--
    File-based skills are copied to the output directory so that McpServerProcessTests can read them from AppContext.BaseDirectory/skills/...
  -->
  <ItemGroup>
    <Content Include="..\..\skills\**" LinkBase="skills">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

</Project>
