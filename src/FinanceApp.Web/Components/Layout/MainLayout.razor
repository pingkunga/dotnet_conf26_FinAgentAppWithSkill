@inherits LayoutComponentBase
@implements IDisposable
@using System.Security.Claims
@inject NavigationManager NavigationManager

<MudThemeProvider />
@*
    Each provider gets its own explicit rendermode attribute, not inherited from a global default on
    Routes — that global-default approach broke Identity's static SSR pages (docs/spec.md §7: they render
    correctly once, then flip to Not Found ~2-3s later once the SignalR circuit connects — invisible to
    curl-based testing since curl never lets a circuit connect). This way each provider is its own
    interactive island, available to whichever page opts into interactive rendering, without dragging
    MainLayout's other consumers (the static Identity pages) into an interactive boundary they can't survive.
*@
<MudPopoverProvider @rendermode="InteractiveServer" />
<MudDialogProvider @rendermode="InteractiveServer" />
<MudSnackbarProvider @rendermode="InteractiveServer" />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6" Class="ml-2">MyFinanceWithAgentSkill</MudText>
        <AuthorizeView>
            <Authorized>
                <MudButton Href="Transactions" Variant="Variant.Text" Color="Color.Inherit" Class="ml-4">Transactions</MudButton>
                <MudButton Href="Budgets" Variant="Variant.Text" Color="Color.Inherit">Budgets</MudButton>
                <MudButton Href="Goals" Variant="Variant.Text" Color="Color.Inherit">Goals</MudButton>
                <MudButton Href="Receipts" Variant="Variant.Text" Color="Color.Inherit">Receipts</MudButton>
                <MudButton Href="Chat" Variant="Variant.Text" Color="Color.Inherit">Chat</MudButton>
            </Authorized>
        </AuthorizeView>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Class="mr-4 align-self-center">@context.User.FindFirstValue(ClaimTypes.Email)</MudText>
                <MudButton Href="Account/Manage" Variant="Variant.Text" Color="Color.Inherit">Account</MudButton>
                <form action="Account/Logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Inherit">Logout</MudButton>
                </form>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="Account/Register" Variant="Variant.Text" Color="Color.Inherit">Register</MudButton>
                <MudButton Href="Account/Login" Variant="Variant.Text" Color="Color.Inherit">Login</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
