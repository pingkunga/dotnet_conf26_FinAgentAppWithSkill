@page "/Chat"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@using FinanceApp.AI
@using FinanceApp.Core
@using FinanceApp.Core.Abstractions
@using FinanceApp.Core.Formatting
@using FinanceApp.Web.Services
@using Markdig
@using Microsoft.Agents.AI
@using Microsoft.Extensions.AI
@inject ChatSessionService ChatSession
@inject FinanceDbContext Db
@inject ICurrentUserAccessor CurrentUser
@inject ILogger<Chat> Logger

<PageTitle>Chat</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Chat</MudText>

<MudGrid>
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4 mb-4" Style="height:60vh; overflow-y:auto;">
            @if (messages.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Ask about your transactions or budgets — e.g. "add a $12 dining expense today" or
                    "how am I doing on my budgets this month?"
                </MudText>
            }
            @foreach (var m in messages)
            {
                <MudText Typo="Typo.body1" Align="@(m.IsUser ? Align.Right : Align.Left)" Class="mb-2">
                    <b>@(m.IsUser ? "You" : "Assistant"):</b>
                    @if (m.IsUser)
                    {
                        @m.Text
                    }
                    else
                    {
                        @((MarkupString)Markdown.ToHtml(m.Text, MarkdownPipeline))
                    }
                </MudText>
            }
            @if (isStreaming)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            }
        </MudPaper>
        @foreach (var approval in pendingApprovals)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-2">
                <div class="mb-2">Agent wants to: <b>@(SkillActivityExtractor.DescribeApprovalRequest(approval) ?? "(unknown action)")</b></div>
                <MudButton Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Class="mr-2"
                           OnClick="@(() => RespondToApprovalAsync(approval, approved: true))">
                    Approve
                </MudButton>
                <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                           OnClick="@(() => RespondToApprovalAsync(approval, approved: false))">
                    Reject
                </MudButton>
            </MudAlert>
        }
        <MudPaper Class="pa-2 d-flex gap-2">
            <MudTextField @bind-Value="input" name="ChatInput" Label="Message" FullWidth="true"
                          Disabled="@(isStreaming || pendingApprovals.Count > 0)" OnKeyDown="OnInputKeyDown" Immediate="true" />
            <MudButton OnClick="SendAsync" Disabled="@(isStreaming || pendingApprovals.Count > 0 || string.IsNullOrWhiteSpace(input))"
                       Color="Color.Primary" Variant="Variant.Filled">
                Send
            </MudButton>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <AgentActivityLog Entries="activityLog" />
    </MudItem>
</MudGrid>

@code {
    // Assistant messages are rendered as markdown (tables, code blocks, emphasis — docs/spec.md §7); user
    // input stays plain text, it never needs formatting. UseAdvancedExtensions() is what makes pipe tables
    // parse at all (Markdig's plain default pipeline leaves "| A | B |" as a literal paragraph — confirmed
    // via a spike). DisableHtml() is not optional: without it, raw HTML in the model's response (e.g. a
    // prompt-injected "<script>...") passes straight through into the page unescaped — confirmed via the
    // same spike (a literal <script> tag survived to the rendered HTML). Built once, not per-render.
    private static readonly MarkdownPipeline MarkdownPipeline =
        new MarkdownPipelineBuilder().UseAdvancedExtensions().DisableHtml().Build();

    // Goals.razor's "Get guidance" button navigates here as /Chat?goalId=<guid> (docs/spec.md §7) — the
    // savings-goals/savings-calculator skills are file-based with no DB access of their own (unlike
    // BudgetSkill), so the only way the agent sees real numbers is if this page puts them in the prompt
    // itself. Loading the goal here, not trusting a prompt string passed through the URL, also means
    // FinanceDbContext's existing HasQueryFilter(g => g.UserId == _currentUserId) is what actually
    // enforces isolation — a hand-edited guid for someone else's goal just resolves to nothing.
    [SupplyParameterFromQuery(Name = "goalId")]
    public Guid? GoalId { get; set; }

    private readonly List<ChatEntry> messages = [];
    private readonly List<SkillActivityEntry> activityLog = [];
    // Populated whenever a stream stops on a gated run_skill_script call (SkillApprovalPolicy,
    // docs/spec.md's approval-toggle plan) — the agent framework surfaces a ToolApprovalRequestContent and
    // the enumeration simply ends, no exception (same 2026-08-11 spike SkillActivityExtractor's doc comment
    // already references). Cleared at the start of every fresh SendAsync; resolved one at a time via
    // RespondToApprovalAsync, which resumes into the same assistant bubble rather than starting a new one.
    private readonly List<ToolApprovalRequestContent> pendingApprovals = [];
    private string input = "";
    private bool isStreaming;
    private bool disposed;
    private CancellationTokenSource? cts;
    private ChatEntry? lastAssistantEntry;

    protected override async Task OnInitializedAsync()
    {
        // Pre-filled, not auto-sent, in both cases below — the user still presses Send.
        // OnInitializedAsync can run twice on an interactive page with prerendering, and there's no LLM
        // available in this environment to verify an auto-sent round trip against.
        if (GoalId is { } goalId)
        {
            var goal = await Db.SavingsGoals.FindAsync(goalId);
            if (goal is not null)
            {
                // SavingsGoal has no Currency column — assumed to be in the user's PreferredCurrency
                // (docs/spec.md's known limitations).
                var user = await Db.Users.FindAsync(CurrentUser.UserId);
                var currency = user?.PreferredCurrency ?? "USD";

                // Not this user's goal (query-filtered out) or it doesn't exist — say nothing rather than
                // reveal which case it was.
                input = $"I have a savings goal called \"{goal.Name}\": current amount {CurrencyFormatter.Format(goal.CurrentAmount, currency)}, " +
                        $"target amount {CurrencyFormatter.Format(goal.TargetAmount, currency)}" +
                        (goal.TargetDate is { } targetDate ? $", target date {targetDate:d}" : "") +
                        (goal.MonthlyContribution is { } contribution ? $", planned monthly contribution {CurrencyFormatter.Format(contribution, currency)}" : "") +
                        ". Give me guidance on this goal, and an exact projection if you can.";
            }
        }
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(input) || isStreaming)
        {
            return;
        }

        // The input/button are disabled while isStreaming, so this can't currently fire mid-stream from
        // the UI — kept anyway as the one line standing between "single send at a time" (today) and
        // "new send supersedes an in-flight one" (e.g. Goals.razor's planned pre-filled-prompt handoff,
        // spec §7), and it's what actually unwinds a stream on DisposeAsync below.
        cts?.Cancel();
        cts?.Dispose();
        cts = new CancellationTokenSource();

        var userMessage = input;
        input = "";
        pendingApprovals.Clear();
        messages.Add(new ChatEntry(IsUser: true, Text: userMessage));
        var assistantEntry = new ChatEntry(IsUser: false, Text: "");
        messages.Add(assistantEntry);
        lastAssistantEntry = assistantEntry;
        isStreaming = true;

        try
        {
            await DrainAsync(ChatSession.SendAsync(userMessage, cts.Token), assistantEntry);
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer send, or the component was disposed — not an error.
        }
        catch (Exception ex)
        {
            ChatErrorDiagnostics.LogFull(Logger, ex, "Chat.SendAsync");
            assistantEntry.Text = $"(error: {ex.Message})";
        }
        finally
        {
            isStreaming = false;
            // DisposeAsync (navigating away mid-stream) cancels the CTS, which unwinds the loop above
            // through the OperationCanceledException branch and lands here — InvokeAsync on an
            // already-disposed component/renderer throws, so guard it rather than let that escape into
            // the circuit.
            if (!disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    /// <summary>
    /// Shared by <see cref="SendAsync"/> and <see cref="RespondToApprovalAsync"/> — both drain an
    /// <see cref="AgentResponseUpdate"/> stream into the same running assistant bubble, appending text,
    /// extracting activity-log entries, and collecting any <see cref="ToolApprovalRequestContent"/> the
    /// stream stops on (docs/spec.md's approval-toggle plan) — the same one-bubble-per-turn shape whether
    /// the turn resolves in one pass or pauses for an approval click first.
    /// </summary>
    private async Task DrainAsync(IAsyncEnumerable<AgentResponseUpdate> stream, ChatEntry assistantEntry)
    {
        await foreach (var update in stream)
        {
            if (!string.IsNullOrEmpty(update.Text))
            {
                assistantEntry.Text += update.Text;
            }

            activityLog.AddRange(SkillActivityExtractor.Extract(update));
            pendingApprovals.AddRange(update.Contents.OfType<ToolApprovalRequestContent>());

            // The await foreach continuation runs off the Blazor sync context — every state mutation
            // needs to go back through InvokeAsync to actually re-render (docs/spec.md §7).
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RespondToApprovalAsync(ToolApprovalRequestContent request, bool approved)
    {
        pendingApprovals.Remove(request);
        if (lastAssistantEntry is null || cts is null)
        {
            return;
        }

        isStreaming = true;
        await InvokeAsync(StateHasChanged);

        var response = request.CreateResponse(approved, reason: null);
        try
        {
            await DrainAsync(ChatSession.ResumeWithApprovalAsync(response, cts.Token), lastAssistantEntry);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            ChatErrorDiagnostics.LogFull(Logger, ex, "Chat.RespondToApprovalAsync");
            lastAssistantEntry.Text += $"\n\n(error: {ex.Message})";
        }
        finally
        {
            isStreaming = false;
            if (!disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task OnInputKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendAsync();
        }
    }

    public ValueTask DisposeAsync()
    {
        disposed = true;
        cts?.Cancel();
        cts?.Dispose();
        return ValueTask.CompletedTask;
    }

    private sealed class ChatEntry(bool IsUser, string Text)
    {
        public bool IsUser { get; } = IsUser;
        public string Text { get; set; } = Text;
    }
}
