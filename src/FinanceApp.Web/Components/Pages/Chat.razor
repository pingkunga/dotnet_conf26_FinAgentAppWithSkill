@page "/Chat"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@using FinanceApp.AI
@using FinanceApp.Core
@using FinanceApp.Web.Services
@using Microsoft.EntityFrameworkCore
@inject ChatSessionService ChatSession
@inject FinanceDbContext Db

<PageTitle>Chat</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Chat</MudText>

<MudGrid>
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4 mb-4" Style="height:60vh; overflow-y:auto;">
            @if (messages.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Ask about your transactions or budgets — e.g. "add a $12 dining expense today" or
                    "how am I doing on my budgets this month?"
                </MudText>
            }
            @foreach (var m in messages)
            {
                <MudText Typo="Typo.body1" Align="@(m.IsUser ? Align.Right : Align.Left)" Class="mb-2">
                    <b>@(m.IsUser ? "You" : "Assistant"):</b> @m.Text
                </MudText>
            }
            @if (isStreaming)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            }
        </MudPaper>
        <MudPaper Class="pa-2 d-flex gap-2">
            <MudTextField @bind-Value="input" name="ChatInput" Label="Message" FullWidth="true"
                          Disabled="isStreaming" OnKeyDown="OnInputKeyDown" Immediate="true" />
            <MudButton OnClick="SendAsync" Disabled="@(isStreaming || string.IsNullOrWhiteSpace(input))"
                       Color="Color.Primary" Variant="Variant.Filled">
                Send
            </MudButton>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <AgentActivityLog Entries="activityLog" />
    </MudItem>
</MudGrid>

@code {
    // Goals.razor's "Get guidance" button navigates here as /Chat?goalId=<guid> (docs/spec.md §7) — the
    // savings-goals/savings-calculator skills are file-based with no DB access of their own (unlike
    // BudgetSkill), so the only way the agent sees real numbers is if this page puts them in the prompt
    // itself. Loading the goal here, not trusting a prompt string passed through the URL, also means
    // FinanceDbContext's existing HasQueryFilter(g => g.UserId == _currentUserId) is what actually
    // enforces isolation — a hand-edited guid for someone else's goal just resolves to nothing.
    [SupplyParameterFromQuery(Name = "goalId")]
    public Guid? GoalId { get; set; }

    // ReceiptUpload.razor's "Extract with AI" button navigates here as /Chat?receiptId=<guid>, same shape
    // as ?goalId= above (docs/spec.md §4.2/§7) — the receipt-OCR inline skill is already registered into
    // this session by ChatSessionService.RegisterReceiptSkill at upload time; this just pre-fills a prompt
    // asking the agent to run it.
    [SupplyParameterFromQuery(Name = "receiptId")]
    public Guid? ReceiptId { get; set; }

    private readonly List<ChatEntry> messages = [];
    private readonly List<SkillActivityEntry> activityLog = [];
    private string input = "";
    private bool isStreaming;
    private bool disposed;
    private CancellationTokenSource? cts;

    protected override async Task OnInitializedAsync()
    {
        // Pre-filled, not auto-sent, in both cases below — the user still presses Send.
        // OnInitializedAsync can run twice on an interactive page with prerendering, and there's no LLM
        // available in this environment to verify an auto-sent round trip against.
        if (GoalId is { } goalId)
        {
            var goal = await Db.SavingsGoals.FindAsync(goalId);
            if (goal is not null)
            {
                // Not this user's goal (query-filtered out) or it doesn't exist — say nothing rather than
                // reveal which case it was.
                input = $"I have a savings goal called \"{goal.Name}\": current amount {goal.CurrentAmount:C}, " +
                        $"target amount {goal.TargetAmount:C}" +
                        (goal.TargetDate is { } targetDate ? $", target date {targetDate:d}" : "") +
                        (goal.MonthlyContribution is { } contribution ? $", planned monthly contribution {contribution:C}" : "") +
                        ". Give me guidance on this goal, and an exact projection if you can.";
            }
        }
        else if (ReceiptId is { } receiptId)
        {
            var receipt = await Db.Receipts.FindAsync(receiptId);
            if (receipt is not null)
            {
                // Names the exact skill, not just "the receipt I uploaded" — every dynamically-registered
                // receipt skill has the same description (ReceiptOcrSkillFactory.Create), so if more than
                // one receipt is pending in this session, only the exact name in the prompt disambiguates
                // which load_skill call is the right one.
                input = $"Please load the skill named \"receipt-ocr-{receipt.Id:N}\" and run its " +
                        "extract_receipt script to OCR this receipt and record it as a transaction.";
            }
        }
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(input) || isStreaming)
        {
            return;
        }

        // The input/button are disabled while isStreaming, so this can't currently fire mid-stream from
        // the UI — kept anyway as the one line standing between "single send at a time" (today) and
        // "new send supersedes an in-flight one" (e.g. Goals.razor's planned pre-filled-prompt handoff,
        // spec §7), and it's what actually unwinds a stream on DisposeAsync below.
        cts?.Cancel();
        cts?.Dispose();
        cts = new CancellationTokenSource();

        var userMessage = input;
        input = "";
        messages.Add(new ChatEntry(IsUser: true, Text: userMessage));
        var assistantEntry = new ChatEntry(IsUser: false, Text: "");
        messages.Add(assistantEntry);
        isStreaming = true;

        try
        {
            await foreach (var update in ChatSession.SendAsync(userMessage, cts.Token))
            {
                if (!string.IsNullOrEmpty(update.Text))
                {
                    assistantEntry.Text += update.Text;
                }

                activityLog.AddRange(SkillActivityExtractor.Extract(update));

                // The await foreach continuation runs off the Blazor sync context — every state mutation
                // needs to go back through InvokeAsync to actually re-render (docs/spec.md §7).
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer send, or the component was disposed — not an error.
        }
        catch (Exception ex)
        {
            assistantEntry.Text = $"(error: {ex.Message})";
        }
        finally
        {
            isStreaming = false;
            // DisposeAsync (navigating away mid-stream) cancels the CTS, which unwinds the loop above
            // through the OperationCanceledException branch and lands here — InvokeAsync on an
            // already-disposed component/renderer throws, so guard it rather than let that escape into
            // the circuit.
            if (!disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task OnInputKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendAsync();
        }
    }

    public ValueTask DisposeAsync()
    {
        disposed = true;
        cts?.Cancel();
        cts?.Dispose();
        return ValueTask.CompletedTask;
    }

    private sealed class ChatEntry(bool IsUser, string Text)
    {
        public bool IsUser { get; } = IsUser;
        public string Text { get; set; } = Text;
    }
}
