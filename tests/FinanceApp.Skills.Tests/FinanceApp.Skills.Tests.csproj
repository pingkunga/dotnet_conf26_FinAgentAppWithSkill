<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FinanceApp.Skills\FinanceApp.Skills.csproj" />
  </ItemGroup>

  <!-- Real skills/savings-calculator content (docs/spec.md §4.3) — SubprocessScriptRunnerTests.cs discovers
       the real script through the file-skill pipeline to get framework-constructed AgentFileSkillScript
       instances (AgentFileSkill/AgentFileSkillScript have no public constructor), same reasoning as
       FinanceApp.Web.csproj's Content item. -->
  <ItemGroup>
    <Content Include="..\..\skills\**" LinkBase="skills">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
